# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/aimesig

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# OTP / SMS (MSG91 or Twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_key
MSG91_TEMPLATE_ID=your_template_id

# WhatsApp Business API
WABA_TOKEN=your_whatsapp_token
WABA_PHONE_ID=your_phone_id

# Email (Resend)
RESEND_API_KEY=your_resend_key
EMAIL_FROM=noreply@aimesig.com

# Firebase (Push Notifications)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Google Maps
GOOGLE_MAPS_API_KEY=your_maps_key

# Redis (Socket.IO scaling)
REDIS_URL=redis://localhost:6379

# Ports
AUTH_SERVICE_PORT=4001
CHAT_SERVICE_PORT=4002
BUSINESS_SERVICE_PORT=4003
SHOP_SERVICE_PORT=4004
HRMS_SERVICE_PORT=4005
ERP_SERVICE_PORT=4006
CRM_SERVICE_PORT=4007
NOTIFICATION_SERVICE_PORT=4008
API_GATEWAY_PORT=4000
